<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template. `just install-service` substitutes __DIR__/__PORT__/__LOG__ and
     writes the result to ~/Library/LaunchAgents/com.ivo.kitchen.plist -->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.ivo.kitchen</string>

    <key>ProgramArguments</key>
    <array>
        <string>__DIR__/run.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__DIR__</string>

    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>

    <key>StandardOutPath</key>
    <string>__LOG__</string>
    <key>StandardErrorPath</key>
    <string>__LOG__</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>KITCHEN_PORT</key>
        <string>__PORT__</string>
        <!-- claude | codex -->
        <key>KITCHEN_OCR_BACKEND</key>
        <string>claude</string>
        <!-- Long-lived OCR token from `claude setup-token`, injected by
             `just install-service` from .ocr-token. Without it the CLI falls
             back to the login Keychain, whose OAuth session is refreshed by
             interactive `claude /login` only in ~/.claude/.credentials.json -
             a launchd process reads the Keychain copy and fails once its
             refresh token lapses. Both lines are dropped if .ocr-token is absent. -->
        <key>CLAUDE_CODE_OAUTH_TOKEN</key>
        <string>__OAUTH_TOKEN__</string>
        <!-- background revalidation interval, seconds -->
        <key>KITCHEN_WARM_SECONDS</key>
        <string>1800</string>
        <!-- watch app/ and restart in place on edit; 0 pins the process -->
        <key>KITCHEN_RELOAD</key>
        <string>1</string>
    </dict>
</dict>
</plist>
